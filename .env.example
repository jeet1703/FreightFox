# Copy to .env and fill in. docker compose reads .env automatically;
# for `mvnw spring-boot:run`, set these as environment variables in your shell instead.

# PhantomBuster (required for real searches)
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
# Optional: LinkedIn li_at cookie; overrides the one saved in the phantom
LINKEDIN_SESSION_COOKIE=
# true = return sample profiles without calling PhantomBuster
PHANTOMBUSTER_MOCK=false

# Host port for the API when run through docker compose
APP_PORT=8080
